# ============================================
# AI Influencer Agency Configuration
# Copy this file to .env and fill in your values
# ============================================

# Buffer API (for auto-scheduling posts)
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
# Get one at: https://bufferapp.com/settings/api

# Imgur API (for public image hosting - optional, can use fallback)
IMGUR_CLIENT_ID=your_imgur_client_id_here
# Get one at: https://api.imgur.com/authorize

# Optional: S3 Bucket for alternative storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
